      }
    },
    "collection_point_YrmerE": {
      "type": "collection-point",
      "blocks": {
        "point_hWkC8C": {
          "type": "point",
          "settings": {
            "label": "その1",
            "heading": "犬本来の食事。それは生のままの自然食。",
            "description": "<p>野生のオオカミは、生肉をまるごと食べて暮らしてきました。そのルーツから、「犬本来の食事とはなにか？」を見つめ直したのが、「ローフード」と呼ばれる生肉食です。現在、愛犬の健康を気にする欧米の多くの飼い主に支持されています。</p>",
            "image": "shopify://shop_images/257f2204c070f93a80d0e45857583636a4ae2938-1442x1048_png.avif"
          }
        },
        "point_6TpAJh": {
          "type": "point",
          "settings": {
            "label": "その2",
            "heading": "日本ではまだ少数派。 でも、確実に 広がっています。",
            "description": "<p>日本では、「生肉はちょっと心配…」という声が根強くあります。でも実は最近、添加物を避けたい人や、愛犬の健康を第一に考える飼い主のあいだで、生食フレッシュフードへの注目が急上昇中。健康の改善をきっかけに、切り替える人も増えてきました。</p>",
            "image": "shopify://shop_images/108b268426c489a41d7276a500a26b56390c83e6-1442x1048_png.avif"
          }
        },
        "point_EQnPFY": {
          "type": "point",
          "settings": {
            "label": "その3",
            "heading": "フランケンソーセージが選ばれる理由。",
            "description": "<p>肉80%、骨10%、内臓10%という理想的なバランスで、犬の健康をしっかりサポート。オメガ3やタウリンが豊富なわかめも加え、栄養価も◎。 主食・トッピング・おやつ、どんなシーンでも使える万能ソーセージです。</p>",
            "image": "shopify://shop_images/762f52b9a7fc016438601e9637e368d7264b8ac3-1442x1048_png.avif"
          }
        }
      },
