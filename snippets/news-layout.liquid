
{%- comment -%}
  News Article Layout Snippet
  3 / 6 / 3 column grid — centre column is the white content card.
  Page background is set on the parent section via inline style (main-blog-post.liquid).
  Content card background color is controlled by section.settings.news_content_bg.
  Pagination: Prev / Back to List / Next — outside the content card at the bottom.
{%- endcomment -%}

{{ 'snippet-news-layout.css' | asset_url | stylesheet_tag }}

{%- comment -%} Neighbour articles for Prev / Next navigation ━━ {%- endcomment -%}
{%- assign blog_articles = blog.articles -%}
{%- assign prev_article = nil -%}
{%- assign next_article = nil -%}
{%- assign found_current = false -%}

{%- for a in blog_articles limit: 50 -%}
  {%- if found_current and next_article == nil -%}
    {%- assign next_article = a -%}
  {%- endif -%}
  {%- if a.id == article.id -%}
    {%- assign found_current = true -%}
  {%- endif -%}
  {%- unless found_current -%}
    {%- assign prev_article = a -%}
  {%- endunless -%}
{%- endfor -%}

<div class="nl-page">
  <div class="nl-container">

    {%- comment -%}━━ 3/6/3 grid ━━{%- endcomment -%}
    <div class="nl-grid">

      {%- comment -%} Left gutter (3) — empty spacer {%- endcomment -%}
      <div class="nl-gutter"></div>

      {%- comment -%} Centre content card (6) {%- endcomment -%}
      <article
        class="nl-card"
        style="background-color: {{ section.settings.news_content_bg | default: '#FFFFFF' }};"
      >

        {%- comment -%} Date ━━ {%- endcomment -%}
        <p class="nl-date">Date: {{ article.published_at | date: '%Y.%m.%d' }}</p>

        {%- comment -%} Title ━━ {%- endcomment -%}
        <h1 class="nl-title">{{ article.title | escape }}</h1>

        <hr class="nl-divider">

        {%- comment -%} Featured image ━━ {%- endcomment -%}
        {%- if article.image != blank -%}
          <div class="nl-image-wrap">
            {{- article.image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                widths: '600, 900, 1200',
                sizes: '(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc(60vw - 48px), min(640px, 50vw)',
                class: 'nl-image',
                alt: article.image.alt | default: article.title | escape
            -}}
          </div>
        {%- endif -%}

        {%- comment -%} Body content ━━ {%- endcomment -%}
        <div class="nl-body rte">
          {{ article.content }}
        </div>

      </article>

      {%- comment -%} Right gutter (3) — empty spacer {%- endcomment -%}
      <div class="nl-gutter"></div>

    </div>

    {%- comment -%}━━ Pagination row — outside the card ━━{%- endcomment -%}
    <nav class="nl-pagination" aria-label="Article navigation">

      <div class="nl-pagination__prev">
        {%- if prev_article -%}
          <a href="{{ prev_article.url }}" class="nl-pagination__btn" aria-label="Previous article">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true">
              <polyline points="10 2 4 8 10 14"/>
            </svg>
            Prev
          </a>
        {%- else -%}
          <span class="nl-pagination__btn nl-pagination__btn--disabled" aria-disabled="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true">
              <polyline points="10 2 4 8 10 14"/>
            </svg>
            Prev
          </span>
        {%- endif -%}
      </div>

      <div class="nl-pagination__center">
        <a href="{{ blog.url }}" class="nl-pagination__back">Back to List</a>
      </div>

      <div class="nl-pagination__next">
        {%- if next_article -%}
          <a href="{{ next_article.url }}" class="nl-pagination__btn" aria-label="Next article">
            Next
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true">
              <polyline points="6 2 12 8 6 14"/>
            </svg>
          </a>
        {%- else -%}
          <span class="nl-pagination__btn nl-pagination__btn--disabled" aria-disabled="true">
            Next
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true">
              <polyline points="6 2 12 8 6 14"/>
            </svg>
          </span>
        {%- endif -%}
      </div>

    </nav>

  </div>
</div>
