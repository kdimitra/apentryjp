
{%- comment -%}
  Home RL Hero — Equal two-column split
  Left  : portrait image
  Right : eyebrow icon + heading + description, vertically centred
{%- endcomment -%}

{{ 'section-home-rl-hero.css' | asset_url | stylesheet_tag }}

<section
  class="rlh-section"
  id="home-rl-hero-{{ section.id }}"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end:   {{ section.settings.padding_bottom }}px;
    --rlh-text-align:    {{ section.settings.text_align }};
    --rlh-heading-color: {{ section.settings.heading_color }};
    --rlh-desc-color:    {{ section.settings.desc_color }};
    --rlh-icon-color:    {{ section.settings.icon_color }};
  "
>
  <div class="rlh-grid rlh-grid--{{ section.settings.image_side }}">

    {%- comment -%}━━ Image column ━━{%- endcomment -%}
    <div class="rlh-col rlh-col--image">
      {%- if section.settings.image != blank -%}
        {{- section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 800, 1200',
            sizes: '(max-width: 767px) 100vw, 50vw',
            class: 'rlh-image',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        -}}
      {%- else -%}
        <div class="rlh-image-placeholder">
          {{ 'image' | placeholder_svg_tag: 'rlh-placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}━━ Text column ━━{%- endcomment -%}
    <div class="rlh-col rlh-col--text">
      <div class="rlh-text-inner">

        {%- comment -%} Eyebrow ━━ {%- endcomment -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="rlh-eyebrow">
            {%- if section.settings.show_eyebrow_icon -%}
              {%- if section.settings.eyebrow_icon != blank -%}
                <span class="rlh-eyebrow__icon" aria-hidden="true">
                  {{- section.settings.eyebrow_icon
                    | image_url: width: 32
                    | image_tag: loading: 'lazy', alt: '' -}}
                </span>
              {%- else -%}
                <span class="rlh-eyebrow__icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                    <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                    <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                    <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                    <circle cx="12" cy="10" r="3"/>
                    <circle cx="20" cy="10" r="3"/>
                  </svg>
                </span>
              {%- endif -%}
            {%- endif -%}
            {{- section.settings.eyebrow | escape -}}
          </p>
        {%- endif -%}

        {%- comment -%} Heading ━━ {%- endcomment -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rlh-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- comment -%} Description ━━ {%- endcomment -%}
        {%- if section.settings.description != blank -%}
          <p class="rlh-desc">{{ section.settings.description | escape }}</p>
        {%- endif -%}

        {%- comment -%} CTA ━━ {%- endcomment -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="rlh-cta">
            {{- section.settings.cta_label | escape -}}
            <span aria-hidden="true"> ›</span>
          </a>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Home RL Hero",
  "class": "section-home-rl-hero",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left",  "label": "Image left, text right" },
        { "value": "right", "label": "Image right, text left" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "そのままの素材で"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow_icon",
      "label": "Show paw icon",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "eyebrow_icon",
      "label": "Custom eyebrow icon",
      "info": "Leave blank to use the default paw icon."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "そのままの愛を。"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "余計なものは使わず、使うのは生の自然食材だけ。からだにやさしいフレッシュフードです。あなたの大切な家族を想って作りました。"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment (desktop)",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F0E4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1C1C1A"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color",
      "default": "#6B6860"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Eyebrow icon color",
      "default": "#87CEDC"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Home RL Hero",
      "settings": {
        "heading": "そのままの愛を。",
        "eyebrow": "そのままの素材で",
        "description": "余計なものは使わず、使うのは生の自然食材だけ。からだにやさしいフレッシュフードです。あなたの大切な家族を想って作りました。"
      }
    }
  ]
}
{% endschema %}
