
{%- comment -%}
  Collection Point Section
  Layout: cream bg · stacked blocks · alternating text-image / image-text
  Odd blocks  (1, 3, …): text left  · image right
  Even blocks (2, 4, …): image left · text right
{%- endcomment -%}

{{ 'section-collection-point.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
<section
  class="cp-section"
  id="{% if section.settings.section_id != blank %}{{ section.settings.section_id | handleize }}{% else %}collection-point-{{ section.id }}{% endif %}"
  style="
    background-color:      {{ section.settings.bg_color }};
    --cp-label-color:      {{ section.settings.label_color }};
    --cp-heading-color:    {{ section.settings.heading_color }};
    --cp-body-color:       {{ section.settings.body_color }};
    --cp-divider-color:    {{ section.settings.divider_color }};
    padding-block-start:   {{ section.settings.padding_top }}px;
    padding-block-end:     {{ section.settings.padding_bottom }}px;
  "
>

  {%- if section.settings.eyebrow != blank or section.settings.section_heading != blank -%}
    <div class="cp-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cp-eyebrow">
          <span class="cp-eyebrow__icon" aria-hidden="true">
            {%- if section.settings.eyebrow_icon_left != blank -%}
              {{- section.settings.eyebrow_icon_left | image_url: width: 36 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                <circle cx="12" cy="10" r="3"/>
                <circle cx="20" cy="10" r="3"/>
              </svg>
            {%- endif -%}
          </span>
          {{- section.settings.eyebrow | escape -}}
          <span class="cp-eyebrow__icon" aria-hidden="true">
            {%- if section.settings.eyebrow_icon_right != blank -%}
              {{- section.settings.eyebrow_icon_right | image_url: width: 36 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                <circle cx="12" cy="10" r="3"/>
                <circle cx="20" cy="10" r="3"/>
              </svg>
            {%- endif -%}
          </span>
        </p>
      {%- endif -%}
      {%- if section.settings.section_heading != blank -%}
        <h2 class="cp-section-heading">{{ section.settings.section_heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'point' -%}
      {%- assign is_even = forloop.index | modulo: 2 -%}

      <div
        class="cp-block{% if is_even == 0 %} cp-block--even{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="cp-block__inner">

          {%- comment -%} Text column {%- endcomment -%}
          <div class="cp-block__text">

            {%- if block.settings.label != blank -%}
              <p class="cp-label">
                <span class="cp-label__icon" aria-hidden="true">
                  {%- if section.settings.label_icon != blank -%}
                    {{- section.settings.label_icon | image_url: width: 36 | image_tag: loading: 'lazy', alt: '' -}}
                  {%- else -%}
                    <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                      <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                      <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                      <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                      <circle cx="12" cy="10" r="3"/>
                      <circle cx="20" cy="10" r="3"/>
                    </svg>
                  {%- endif -%}
                </span>
                {{- block.settings.label | escape -}}
              </p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="cp-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="cp-desc">{{ block.settings.description }}</div>
            {%- endif -%}

          </div>

          {%- comment -%} Image column {%- endcomment -%}
          <div class="cp-block__image">
            {%- if block.settings.image != blank -%}
              {{- block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 900, 1200, 1400',
                  sizes: '(max-width: 767px) 100vw, 58vw',
                  class: 'cp-image',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              -}}
            {%- else -%}
              <div class="cp-image-placeholder">
                {{ 'image' | placeholder_svg_tag: 'cp-placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

        </div>

       

      </div>
    {%- endif -%}
  {%- endfor -%}

</section>
{%- endif -%}

{% schema %}
{
  "name": "Collection point",
  "tag": "section",
  "class": "section-collection-point",
  "settings": [
    {
      "type": "header",
      "content": "Section ID"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Used for scroll targeting. No spaces or # (e.g. collection-point-section)."
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Collection Point"
    },
    {
      "type": "image_picker",
      "id": "eyebrow_icon_left",
      "label": "Left paw icon (SVG/PNG)",
      "info": "Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "image_picker",
      "id": "eyebrow_icon_right",
      "label": "Right paw icon (SVG/PNG)",
      "info": "Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "なぜ、アニーズパントリーなのか。"
    },
    {
      "type": "header",
      "content": "Label icon"
    },
    {
      "type": "image_picker",
      "id": "label_icon",
      "label": "Label paw icon (SVG/PNG)",
      "info": "Shared across all blocks. Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#F5F0E4"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#87CEDC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2C2420"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#5A4A3A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#E2DDD6"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (e.g. その1)",
          "default": "その1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "犬本来の食事。\nそれは生のままの自然食。"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>野生のオオカミは、生肉をまるごと食べて暮らしてきました。そのルーツから、「犬本来の食事とはなにか？」を見つめ直したのが、「ローフード」と呼ばれる生肉食です。現在、愛犬の健康を気にする欧米の多くの飼い主に支持されています。</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection point",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "label": "その1",
            "heading": "犬本来の食事。\nそれは生のままの自然食。",
            "description": "<p>野生のオオカミは、生肉をまるごと食べて暮らしてきました。そのルーツから、「犬本来の食事とはなにか？」を見つめ直したのが、「ローフード」と呼ばれる生肉食です。現在、愛犬の健康を気にする欧米の多くの飼い主に支持されています。</p>"
          }
        },
        {
          "type": "point",
          "settings": {
            "label": "その2",
            "heading": "新鮮な素材だけを、\nそのままに。",
            "description": "<p>アニーズパントリーでは、信頼できる生産者から新鮮な食材だけを仕入れています。余計な加工や添加物を加えず、素材本来の栄養とおいしさをそのままお届けします。</p>"
          }
        },
        {
          "type": "point",
          "settings": {
            "label": "その3",
            "heading": "毎日食べるものだから、\n正直でありたい。",
            "description": "<p>何が入っているかが分かる、透明性の高いフード。愛犬が毎日安心して食べられるごはんを、真摯に作り続けます。</p>"
          }
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
