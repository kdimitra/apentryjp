
{%- comment -%}
  About Pap Tab Section
  Layout: sky-blue bg · centered eyebrow + heading
          two-column body (image left · subheading + body right) · dog illustration
          3-col feature card grid below
{%- endcomment -%}

{{ 'section-about-pap-tab.css' | asset_url | stylesheet_tag }}

<section
  class="apt-section"
  id="{% if section.settings.section_id != blank %}{{ section.settings.section_id | handleize }}{% else %}about-pap-tab-{{ section.id }}{% endif %}"
  style="
    background-color: {{ section.settings.bg_color }};
    --apt-card-bg:          {{ section.settings.card_bg_color }};
    --apt-badge-bg:         {{ section.settings.badge_bg_color }};
    --apt-badge-text:       {{ section.settings.badge_text_color }};
    --apt-heading-color:    {{ section.settings.heading_color }};
    --apt-body-color:       {{ section.settings.body_color }};
    --apt-eyebrow-color:    {{ section.settings.eyebrow_color }};
    --apt-img-bg:           {{ section.settings.image_bg_color }};
    padding-block-start:    {{ section.settings.padding_top }}px;
    padding-block-end:      {{ section.settings.padding_bottom }}px;
  "
>
  <div class="apt-wrapper">

    {%- comment -%}━━━━━━━━ HEADER ━━━━━━━━{%- endcomment -%}
    <div class="apt-header">

      {%- if section.settings.eyebrow != blank -%}
        <p class="apt-eyebrow">
          <span class="apt-eyebrow__icon" aria-hidden="true">
            {%- if section.settings.eyebrow_icon_left != blank -%}
              {{- section.settings.eyebrow_icon_left | image_url: width: 36 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                <circle cx="12" cy="10" r="3"/>
                <circle cx="20" cy="10" r="3"/>
              </svg>
            {%- endif -%}
          </span>
          {{- section.settings.eyebrow -}}
          <span class="apt-eyebrow__icon" aria-hidden="true">
            {%- if section.settings.eyebrow_icon_right != blank -%}
              {{- section.settings.eyebrow_icon_right | image_url: width: 36 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                <circle cx="12" cy="10" r="3"/>
                <circle cx="20" cy="10" r="3"/>
              </svg>
            {%- endif -%}
          </span>
        </p>
      {%- endif -%}

      {%- if section.settings.section_heading != blank -%}
        <h2 class="apt-heading">{{ section.settings.section_heading }}</h2>
      {%- endif -%}

    </div>

    {%- comment -%}━━━━━━━━ TWO-COLUMN BODY ━━━━━━━━{%- endcomment -%}
    <div class="apt-body{% if section.settings.image_position == 'right' %} apt-body--img-right{% endif %}">

      {%- comment -%} Image column {%- endcomment -%}
      <div class="apt-body__image">
        <div class="apt-body__image-wrap">
          {%- if section.settings.body_image != blank -%}
            {{- section.settings.body_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '450, 700, 900',
                sizes: '(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc(50vw - 40px), 44vw',
                class: 'apt-body__img',
                alt: section.settings.body_image.alt | default: section.settings.section_heading | escape
            -}}
          {%- else -%}
            <div class="apt-body__img-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'apt-placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Text column {%- endcomment -%}
      <div class="apt-body__text">
        {%- if section.settings.body_subheading != blank -%}
          <h3 class="apt-body__subheading">{{ section.settings.body_subheading }}</h3>
        {%- endif -%}
        {%- if section.settings.body_text != blank -%}
          <div class="apt-body__desc">{{ section.settings.body_text }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} Dog illustration {%- endcomment -%}
      {%- if section.settings.show_dog and section.settings.dog_image != blank -%}
        <div class="apt-dog" aria-hidden="true">
          {{- section.settings.dog_image
            | image_url: width: 480
            | image_tag:
              loading: 'lazy',
              widths: '240, 360, 480',
              sizes: '220px',
              alt: ''
          -}}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%}━━━━━━━━ FEATURE CARDS ━━━━━━━━{%- endcomment -%}
    {%- assign feature_blocks = section.blocks | where: 'type', 'feature_card' -%}
    {%- if feature_blocks.size > 0 -%}
      <div class="apt-features" style="--apt-cols: {{ feature_blocks.size | at_most: 4 }};">
        {%- for block in feature_blocks -%}
          <div class="apt-card" {{ block.shopify_attributes }} style="--ci: {{ forloop.index0 }};">

            {%- if block.settings.badge_label != blank -%}
              <span class="apt-card__badge">{{ block.settings.badge_label | escape }}</span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="apt-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            <div class="apt-card__image-wrap">
              {%- if block.settings.image != blank -%}
                {{- block.settings.image
                  | image_url: width: 320
                  | image_tag:
                    loading: 'lazy',
                    widths: '160, 240, 320',
                    sizes: '140px',
                    class: 'apt-card__img',
                    alt: block.settings.image.alt | default: block.settings.title | escape
                -}}
              {%- else -%}
                <div class="apt-card__img-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'apt-placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.description != blank -%}
              <div class="apt-card__desc">{{ block.settings.description }}</div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "About Pap Tab",
  "tag": "section",
  "class": "section-about-pap-tab",
  "settings": [
    {
      "type": "header",
      "content": "Section ID"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Used for scroll targeting. No spaces or # (e.g. about-pap-tab-section)."
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "About"
    },
    {
      "type": "image_picker",
      "id": "eyebrow_icon_left",
      "label": "Left paw icon (SVG/PNG)",
      "info": "Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "image_picker",
      "id": "eyebrow_icon_right",
      "label": "Right paw icon (SVG/PNG)",
      "info": "Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "About Pap Tabs"
    },
    {
      "type": "header",
      "content": "Body — Image"
    },
    {
      "type": "image_picker",
      "id": "body_image",
      "label": "Body image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image column position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image background color",
      "default": "#B8DDE6"
    },
    {
      "type": "header",
      "content": "Body — Text"
    },
    {
      "type": "text",
      "id": "body_subheading",
      "label": "Sub-heading",
      "default": "With the same ingredients, with the same love."
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>We use only raw, natural ingredients, without adding anything unnecessary.</p><p>This is a gentle, raw, fresh food for your pet.</p><p>We made it with your beloved family member in mind.</p>"
    },
    {
      "type": "header",
      "content": "Dog illustration"
    },
    {
      "type": "checkbox",
      "id": "show_dog",
      "label": "Show dog illustration",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "dog_image",
      "label": "Dog illustration image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#87CEDC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2C2420"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#3A2E28"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#5A4232"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Feature card background",
      "default": "#FEF8EC"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#87CEDC"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#2C5A64"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature card",
      "settings": [
        {
          "type": "text",
          "id": "badge_label",
          "label": "Badge label",
          "default": "Feature 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Raw meat that lets the natural flavor of the ingredients shine through."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (circular)"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Because it's uncooked, it retains the full flavor of the meat. The abundant protein supports healthy body building.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Pap Tab",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "badge_label": "Feature 1",
            "title": "Raw meat that lets the natural flavor of the ingredients shine through.",
            "description": "<p>Because it's uncooked, it retains the full flavor of the meat. The abundant protein supports healthy body building.</p>"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "badge_label": "Feature 2",
            "title": "Domestic manufacturing for peace of mind and reliability",
            "description": "<p>All products are manufactured and managed at factories in Japan. We deliver peace of mind to your whole family with our reliable quality.</p>"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "badge_label": "Feature 3",
            "title": "Additive-free meals containing only the essentials.",
            "description": "<p>No artificial flavors, colors, or preservatives are used. We deliver the natural deliciousness and peace of mind of the ingredients as they are.</p>"
          }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
