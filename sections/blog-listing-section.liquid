
{%- comment -%}
  Blog Listing Section
  Layout: warm-cream bg · left intro col (4) · right 3-col open card grid (8)
  Animation: staggered fade-up via IntersectionObserver
{%- endcomment -%}

{%- liquid
  assign source_blog  = blogs[section.settings.blog]
  assign posts_limit  = section.settings.posts_to_show
  assign has_articles = false
  if source_blog != blank and source_blog.articles_count > 0
    assign has_articles = true
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign img_ratio = '3 / 4'
    when 'wide'
      assign img_ratio = '16 / 9'
    else
      assign img_ratio = '4 / 3'
  endcase
-%}

{{ 'section-blog-listing.css' | asset_url | stylesheet_tag }}

<section
  class="section-blog-listing"
  id="blog-listing-{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }}; --bl-img-ratio: {{ img_ratio }};"
>
  <div class="bl-container">
    <div class="bl-inner">

      {%- comment -%}━━ LEFT: Intro column (4) ━━{%- endcomment -%}
      <div class="bl-label-col">

        {%- if section.settings.heading != blank -%}
          <h2 class="bl-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro_text != blank -%}
          <p class="bl-intro">{{ section.settings.intro_text }}</p>
        {%- endif -%}

        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="bl-viewall">
            {{- section.settings.cta_label -}}
          </a>
        {%- endif -%}

        {%- if section.settings.decoration_image != blank -%}
          <div class="bl-decoration">
            {{- section.settings.decoration_image
              | image_url: width: 320
              | image_tag:
                loading: 'lazy',
                widths: '160, 240, 320',
                sizes: '200px',
                alt: ''
            -}}
          </div>
        {%- endif -%}

      </div>

      {%- comment -%}━━ RIGHT: Blog card grid (8) ━━{%- endcomment -%}
      <ul class="bl-grid bl-animate-container" role="list">

        {%- if has_articles -%}
          {%- for article in source_blog.articles limit: posts_limit -%}
            <li class="bl-card bl-animate-card" style="--bl-card-index: {{ forloop.index0 }};">
              <a href="{{ article.url }}" class="bl-card__link">

                {%- if article.image != blank -%}
                  <div class="bl-card__image-wrap">
                    {{- article.image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800',
                        sizes: '(max-width: 749px) calc(50vw - 24px), (max-width: 1023px) calc(50vw - 56px), calc((100vw - 360px - 80px) / 3)',
                        class: 'bl-card__image',
                        alt: article.image.alt | default: article.title | escape
                    -}}
                  </div>
                {%- else -%}
                  <div class="bl-card__image-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                {%- endif -%}

                <div class="bl-card__body">
                  {%- if section.settings.show_date -%}
                    <time class="bl-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{- article.published_at | date: '%Y.%m.%d' -}}
                    </time>
                  {%- endif -%}
                  <h3 class="bl-card__title">{{ article.title | escape }}</h3>
                  {%- if section.settings.show_category and article.tags.size > 0 -%}
                    <p class="bl-card__category">{{ article.tags | first }}</p>
                  {%- endif -%}
                </div>

              </a>
            </li>
          {%- endfor -%}

        {%- else -%}
          {%- for i in (1..3) -%}
            <li class="bl-card bl-animate-card" style="--bl-card-index: {{ forloop.index0 }};">
              <div class="bl-card__link">
                <div class="bl-card__image-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
                <div class="bl-card__body">
                  {%- if section.settings.show_date -%}
                    <span class="bl-card__date">2026.05.07</span>
                  {%- endif -%}
                  {%- if i == 1 -%}
                    <h3 class="bl-card__title">ドッグフードの種類を比較：ドライ・ウェット・フレッシュの違いと選び方</h3>
                    {%- if section.settings.show_category -%}<p class="bl-card__category">健康 &amp; 栄養</p>{%- endif -%}
                  {%- elsif i == 2 -%}
                    <h3 class="bl-card__title">「パップタブで変わったうちの子の毎日｜実際の愛用者にインタビュー」</h3>
                    {%- if section.settings.show_category -%}<p class="bl-card__category">ライフスタイル</p>{%- endif -%}
                  {%- else -%}
                    <h3 class="bl-card__title">フードを変えても治らない?犬の皮膚トラブルの本当の原因と正しい対策</h3>
                    {%- if section.settings.show_category -%}<p class="bl-card__category">健康 &amp; 栄養</p>{%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}

      </ul>
    </div>
  </div>
</section>

<script>
(function () {
  var section = document.getElementById('blog-listing-{{ section.id }}');
  if (!section) return;

  var cards = section.querySelectorAll('.bl-animate-card');

  if (!('IntersectionObserver' in window)) {
    cards.forEach(function (c) { c.classList.add('bl-animate-card--visible'); });
    return;
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      var card  = entry.target;
      var index = parseInt(card.style.getPropertyValue('--bl-card-index') || '0', 10);
      setTimeout(function () {
        card.classList.add('bl-animate-card--visible');
      }, index * 120);
      observer.unobserve(card);
    });
  }, { threshold: 0.12 });

  cards.forEach(function (card) { observer.observe(card); });
})();
</script>

{% schema %}
{
  "name": "Blog listing",
  "class": "blog-listing-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blog"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Description",
      "default": "しつけや食事、健康管理から心温まるエピソードまで、愛犬家のための情報を幅広くお届けします。"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "decoration_image",
      "label": "Decoration image (e.g. dog illustration)"
    },
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Number of posts",
      "min": 3,
      "max": 9,
      "step": 3,
      "default": 3
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "portrait",  "label": "Portrait (3:4)" },
        { "value": "wide",      "label": "Wide (16:9)" }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category (first tag)",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F4F1EC"
    }
  ],
  "presets": [
    { "name": "Blog listing" }
  ]
}
{% endschema %}
