
{%- comment -%}
  Header Ribbon Section
  Layout: full-width colour strip · eyebrow label with left/right paw icons
{%- endcomment -%}

{{ 'section-header-ribbon.css' | asset_url | stylesheet_tag }}

{%- assign align_map = section.settings.text_align -%}
{%- if align_map == 'left' -%}
  {%- assign justify = 'flex-start' -%}
{%- elsif align_map == 'right' -%}
  {%- assign justify = 'flex-end' -%}
{%- else -%}
  {%- assign justify = 'center' -%}
{%- endif -%}

<div
  class="hr-section"
  id="{% if section.settings.section_id != blank %}{{ section.settings.section_id | handleize }}{% else %}header-ribbon-{{ section.id }}{% endif %}"
  style="
    background-color:    {{ section.settings.bg_color }};
    --hr-text-color:     {{ section.settings.text_color }};
    --hr-align:          {{ justify }};
    --hr-padding-y:      {{ section.settings.padding_y }}px;
    --hr-padding-x:      {{ section.settings.padding_x }}px;
  "
>
  <div class="hr-inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="hr-eyebrow">

        {%- comment -%} Left icon {%- endcomment -%}
        {%- if section.settings.show_icons -%}
          <span class="hr-eyebrow__icon" aria-hidden="true">
            {%- if section.settings.icon_left != blank -%}
              {{- section.settings.icon_left | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                <circle cx="12" cy="10" r="3"/>
                <circle cx="20" cy="10" r="3"/>
              </svg>
            {%- endif -%}
          </span>
        {%- endif -%}

        {{- section.settings.eyebrow | escape -}}

        {%- comment -%} Right icon {%- endcomment -%}
        {%- if section.settings.show_icons -%}
          <span class="hr-eyebrow__icon" aria-hidden="true">
            {%- if section.settings.icon_right != blank -%}
              {{- section.settings.icon_right | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' -}}
            {%- else -%}
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                <ellipse cx="16" cy="22.5" rx="6.5" ry="5.5"/>
                <ellipse cx="7.5" cy="15" rx="3" ry="3.8" transform="rotate(-10 7.5 15)"/>
                <ellipse cx="24.5" cy="15" rx="3" ry="3.8" transform="rotate(10 24.5 15)"/>
                <circle cx="12" cy="10" r="3"/>
                <circle cx="20" cy="10" r="3"/>
              </svg>
            {%- endif -%}
          </span>
        {%- endif -%}

      </p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Header ribbon",
  "tag": "div",
  "class": "section-header-ribbon",
  "settings": [
    {
      "type": "header",
      "content": "Section ID"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Used for scroll targeting. No spaces or # (e.g. header-ribbon-section)."
    },
    {
      "type": "header",
      "content": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label text",
      "default": "Annie's Pantry"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Label alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Paw icons"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show paw icons",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "icon_left",
      "label": "Left icon (SVG/PNG)",
      "info": "Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "image_picker",
      "id": "icon_right",
      "label": "Right icon (SVG/PNG)",
      "info": "Leave blank to use the built-in default paw SVG."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#87CEDC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & icon color",
      "default": "#5A4232"
    }
  ],
  "presets": [
    {
      "name": "Header ribbon",
      "settings": {
        "eyebrow": "Annie's Pantry",
        "text_align": "center",
        "show_icons": true,
        "padding_y": 32,
        "padding_x": 40,
        "bg_color": "#87CEDC",
        "text_color": "#5A4232"
      }
    }
  ]
}
{% endschema %}
